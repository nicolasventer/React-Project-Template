{
	"name": "client",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "serve -l 4173 ./dist",
		"devhost": "bunx --bun vite --host",
		"devhttps": "cross-env USE_HTTPS=true npx vite",
		"devhttpshost": "cross-env USE_HTTPS=true npx vite --host",
		"_preview": "vite preview",
		"lint": "eslint .",
		"depgraph": "depcruise --version && depcruise --config depcruise-config.cjs --output-type archi src | dot -T svg | depcruise-wrap-stream-in-html > graph-dependencies.html && cmd /c \"start graph-dependencies.html\""
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/dom-view-transitions": "1.0.6",
		"@types/node": "25.5.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.57.1",
		"@vitejs/plugin-react": "6.0.1",
		"cross-env": "10.1.0",
		"dependency-cruiser": "17.3.9",
		"eslint": "9.39.4",
		"eslint-plugin-no-relative-import-paths": "1.6.1",
		"eslint-plugin-project-structure": "3.14.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.5.2",
		"globals": "17.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.57.1",
		"vite": "8.0.1",
		"vite-plugin-mkcert": "1.17.10",
		"vite-plugin-svgr": "4.5.0"
	},
	"dependencies": {
		"clsx": "2.1.1",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	}
}
