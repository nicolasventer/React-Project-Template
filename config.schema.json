{
  "$id": "Config",
  "type": "object",
  "required": [
    "$schema",
    "features"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "required": [
        "counter",
        "timer"
      ],
      "properties": {
        "counter": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "specific": {
              "type": "object",
              "required": [
                "increment"
              ],
              "properties": {
                "increment": {
                  "type": "number"
                }
              }
            }
          }
        },
        "timer": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}